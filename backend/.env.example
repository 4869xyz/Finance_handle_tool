DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/invoice_db

# LLM provider (optional): openai, anthropic, google, qwen, deepseek, zhipu
LLM_PROVIDER=qwen
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Monthly document batch limits
BATCH_MAX_FILE_SIZE=157286400
BATCH_MAX_TOTAL_SIZE=268435456
BATCH_MAX_FILES=200
BATCH_IMAGE_MAX_PIXELS=50000000
BATCH_PROCESSING_CONCURRENCY=2
BATCH_CLASSIFICATION_THRESHOLD=0.80
BATCH_EXTRACTION_THRESHOLD=0.75

# Optional: require token to configure LLM via API
LLM_CONFIG_TOKEN=
DEBUG=true
